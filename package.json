{
  "name": "@lapismd/terminal-host",
  "version": "0.1.0",
  "description": "Deno PTY process host and authenticated WebSocket server for LapisMD terminals",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22",
    "deno": ">=2.9.5"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "homepage": "https://github.com/lapismd/terminal-host#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/terminal-host.git"
  },
  "bugs": {
    "url": "https://github.com/lapismd/terminal-host/issues"
  },
  "files": [
    "bin/",
    "dist/",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "native-artifacts.json",
    "deno.lock",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md",
    "spec/src/*.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "bin": {
    "lapis-terminal-host": "./bin/lapis-terminal-host.mjs"
  },
  "scripts": {
    "build": "deno check src/index.ts src/client.ts src/cli.ts && node scripts/build-client.mjs",
    "serve:local": "deno run -A scripts/serve-local.ts",
    "check": "pnpm spec:validate && pnpm check:types",
    "check:types": "deno check src/index.ts src/client.ts src/cli.ts",
    "test": "vitest run src/session-service.test.ts src/cwd.test.ts src/shell.test.ts src/parse-cli.test.ts && deno test -A tests/deno",
    "checks:release": "pnpm spec:check && pnpm check && pnpm test && pnpm build",
    "changeset": "changeset",
    "packages:check": "pnpm release:check",
    "packages:pack": "node ./scripts/terminal-host-release.mjs pack-check",
    "release:check": "node ./scripts/terminal-host-release.mjs check",
    "release:notes": "node ./scripts/terminal-host-release.mjs notes",
    "release:plan": "node ./scripts/terminal-host-release.mjs plan",
    "release:prepare": "node ./scripts/terminal-host-release.mjs prepare",
    "release:publish": "node ./scripts/terminal-host-release.mjs publish",
    "release:verify": "node ./scripts/terminal-host-release.mjs verify",
    "release:version": "changeset version && pnpm install --lockfile-only && prettier package.json CHANGELOG.md --write",
    "spec:build": "spec-validator build",
    "spec:check": "spec-validator check",
    "spec:first": "spec-validator first",
    "spec:validate": "spec-validator validate"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "deno": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./deno": {
      "types": "./src/deno.ts",
      "deno": "./dist/deno.js",
      "import": "./dist/deno.js",
      "default": "./dist/deno.js"
    },
    "./native-artifacts.json": "./native-artifacts.json",
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@lapismd/spec-validator": "0.1.0",
    "@types/node": "22.20.1",
    "esbuild": "^0.27.4",
    "prettier": "^3.7.4",
    "vitest": "^4.1.8"
  }
}
