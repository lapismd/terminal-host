{
  "name": "@lapismd/terminal-host",
  "private": true,
  "version": "0.0.0",
  "description": "Deno PTY process host and authenticated WebSocket server for LapisMD terminals",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "deno": ">=2.9.5"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "lapis-terminal-host": "./bin/lapis-terminal-host.mjs"
  },
  "scripts": {
    "build": "deno check src/index.ts src/client.ts src/cli.ts",
    "serve:local": "deno run -A scripts/serve-local.ts",
    "check": "pnpm spec:validate && pnpm check:types",
    "check:types": "deno check src/index.ts src/client.ts src/cli.ts",
    "test": "vitest run src/session-service.test.ts src/cwd.test.ts src/shell.test.ts src/parse-cli.test.ts && deno test -A tests/deno",
    "spec:build": "spec-validator build",
    "spec:check": "spec-validator check",
    "spec:first": "spec-validator first",
    "spec:validate": "spec-validator validate"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./deno": {
      "types": "./src/deno.ts",
      "import": "./src/deno.ts",
      "default": "./src/deno.ts"
    },
    "./native-artifacts.json": "./native-artifacts.json",
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@lapismd/spec-validator": "link:../spec-validator",
    "vitest": "^4.1.8"
  }
}
